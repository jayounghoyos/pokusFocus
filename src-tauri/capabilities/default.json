{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window plus the break overlay and eye-rest toast windows it opens",
  "windows": [
    "main",
    "overlay",
    "toast"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default",
    "notification:allow-notify",
    "store:default",
    "os:default",
    "autostart:default"
  ]
}
